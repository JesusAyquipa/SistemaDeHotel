# URL base del backend Laravel (sin /api; si se incluye /api se elimina automáticamente para los assets).
# En desarrollo, si no se define, se usa http://localhost:8000.
VITE_API_BASE_URL=http://localhost:8000

# WebSockets (Laravel Reverb). Si VITE_REVERB_APP_KEY no está definida, no se conecta.
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# Nombre del hotel mostrado en la interfaz (por defecto "Hotel Demo").
VITE_HOTEL_NAME=Hotel Demo
