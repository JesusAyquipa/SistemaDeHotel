APP_NAME="Sistema de Reservas Hotel API"
APP_ENV=local
# Generar con: php artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Lima
APP_URL=http://localhost:8000

# URL pública de la SPA (enlaces en correos + origen CORS permitido)
FRONTEND_URL=http://localhost:5173
# Orígenes CORS adicionales separados por comas (opcional)
CORS_ALLOWED_ORIGINS=
# Regex de orígenes permitidos separadas por comas (opcional), ej: #^https://mi-app-[a-z0-9-]+\.vercel\.app$#
CORS_ALLOWED_ORIGIN_PATTERNS=
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
# Vida útil de los tokens Bearer en minutos (10080 = 7 días)
SANCTUM_TOKEN_EXPIRATION=10080

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Base de datos MySQL local
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hotel_reservas
DB_USERNAME=root
DB_PASSWORD=
# Ruta al certificado CA solo si la BD exige TLS (p. ej. TiDB Cloud): /var/www/html/isrgrootx1.pem
MYSQL_ATTR_SSL_CA=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Laravel Reverb (WebSockets). Generar valores propios, p. ej.:
#   php -r "echo bin2hex(random_bytes(16));"
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@hotelreservas.com"
MAIL_FROM_NAME="${APP_NAME}"

# Pasarela de pago: simulation (demo) | stripe
PAYMENT_GATEWAY=simulation
# Secreto HMAC del webhook de pagos (header X-Signature). Vacío = webhook deshabilitado (401).
#   php -r "echo bin2hex(random_bytes(32));"
PAYMENT_WEBHOOK_SECRET=

# Cuentas demo creadas por `php artisan db:seed`.
# Si la contraseña queda vacía se genera una aleatoria y se muestra en consola.
SEED_ADMIN_EMAIL=admin@hotel.com
SEED_ADMIN_PASSWORD=
SEED_RECEPCION_EMAIL=recepcion@hotel.com
SEED_RECEPCION_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
