# Monorepo Root .gitignore

# Dependencias
**/node_modules/
**/vendor/

# Archivos de entorno (nunca versionar secretos)
**/.env
**/.env.local
**/.env.*.local
**/.env.backup
**/.env.production
!**/.env.example

# Build outputs
**/dist/
**/build/
**/.vite/

# IDE / Sistema
.vscode/
.idea/
.fleet/
.zed/
*.suo
*.user
*.userosscache
*.sln.docstates
.DS_Store
Thumbs.db

# Laravel (hotel-backend)
hotel-backend/storage/*.key
hotel-backend/storage/pail/
hotel-backend/storage/app/public/*
!hotel-backend/storage/app/public/.gitignore
hotel-backend/storage/framework/cache/data/*
hotel-backend/storage/framework/sessions/*
hotel-backend/storage/framework/testing/*
hotel-backend/storage/framework/views/*
hotel-backend/storage/logs/*
hotel-backend/bootstrap/cache/*.php
hotel-backend/public/build/
hotel-backend/public/hot
hotel-backend/public/storage
# Subidas antiguas (ahora se guardan en storage/app/public)
hotel-backend/public/profiles/
hotel-backend/auth.json
hotel-backend/.phpunit.cache/

# Testing & logs
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/coverage/
**/.phpunit.result.cache
